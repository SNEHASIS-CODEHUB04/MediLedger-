{
  "name": "mediledger",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test -w @mediledger/api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "lint": "eslint apps packages"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "prisma": "6.19.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "effect": "3.22.5"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
